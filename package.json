{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "bun run typecheck && vite build",
    "start": "vite preview --host 0.0.0.0",
    "typecheck": "tsrs --noEmit --project tsconfig.json",
    "checks": "bun run typecheck && oxlint",
    "test": "vitest run --pool threads --maxWorkers 1 --testTimeout 15000",
    "test:browser": "bun scripts/mini-games.browser.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "oxlint": "1.93.0",
    "playwright": "1.65.1",
    "tsrs": "0.23.0-ts7.1.0-beta",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "packageManager": "bun@1.4.4"
}
